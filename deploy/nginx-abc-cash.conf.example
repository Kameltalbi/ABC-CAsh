# ABC Cash API derrière Nginx (multi-apps sur le même VPS)
#
# L'API écoute en local sur 127.0.0.1:8081 (docker-compose).
# Nginx expose le path /abc-cash/ vers cette API.
#
# IP VPS : 213.130.144.183
# URL exemple : http://213.130.144.183/abc-cash/health

location /abc-cash/ {
    proxy_pass http://127.0.0.1:8081/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
}

# Avec un nom de domaine + HTTPS (recommandé) :
# location /abc-cash/ { ... } dans le server block SSL
