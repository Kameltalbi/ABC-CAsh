# ABC Cash API — variables d'environnement (copier vers .env sur le VPS)

# API
PORT=8081
HOST=127.0.0.1
JWT_SECRET=remplacer-par-une-longue-chaine-aleatoire

# PostgreSQL (conteneur Docker interne)
DATABASE_URL=jdbc:postgresql://abc-cash-db:5432/abc_cash
DATABASE_USER=abc_cash
DATABASE_PASSWORD=remplacer-mot-de-passe-fort

# Postgres image
POSTGRES_DB=abc_cash
POSTGRES_USER=abc_cash
POSTGRES_PASSWORD=remplacer-mot-de-passe-fort
